<% identity = Rails.configuration.x.foundation %>
<% title "Emberfield Roast" %>

<section class="md-hero" aria-labelledby="hero-title">
  <div class="md-hero__inner">
    <div>
      <p class="md-section__eyebrow"><%= identity[:application_name] %></p>
      <h1 id="hero-title">Small-batch coffee, roasted to order.</h1>
      <p><%= identity[:default_page_description] %></p>
      <div class="md-actions">
        <%= link_to "Shop the roast", storefront_products_path, class: "md-button md-button--filled" %>
        <% unless user_signed_in? %>
          <%= link_to "Create an account", new_user_registration_path, class: "md-button md-button--outlined" %>
        <% end %>
      </div>
    </div>
    <div class="md-hero__art" aria-hidden="true"><div class="md-hero__orb"></div></div>
  </div>
</section>

<section class="md-section" aria-labelledby="story-title">
  <div class="md-section__inner md-stack">
    <p class="md-section__eyebrow">Roasted every week</p>
    <h2 id="story-title" class="md-section__heading">From green beans to your door, in small batches.</h2>
    <p>We buy direct from the farms we list on every bag, roast in 5 kg batches on Fridays, and ship the week the coffee is at its best. Sign in to keep your order history, or check out as a guest — it takes an email.</p>
    <div class="md-actions">
      <%= link_to "Browse the catalog", storefront_products_path, class: "md-button md-button--filled" %>
      <%= link_to "Your orders", storefront_orders_path, class: "md-button md-button--outlined" if user_signed_in? %>
    </div>
  </div>
</section>
